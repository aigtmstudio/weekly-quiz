# Copy to .env.local for development. In production these live in Vercel
# environment variables — that is the whole point of the move off scheduled
# Claude tasks, so nothing in the daily path needs approving.

# Supabase — the "Enablement App" project (zpsljfgcjvshqxjbxgid).
# The anon key is public by design and is safe in the browser.
NEXT_PUBLIC_SUPABASE_URL=https://zpsljfgcjvshqxjbxgid.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only. Bypasses row-level security. Never prefix this NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# Only needed to run scripts/migrate-legacy.ts once. The old daily_facts,
# quiz_sessions, quiz_questions and quiz_answers tables stay in the previous
# project (xnausliedmpumzkfyrrx) and are read from there, never copied over.
# Delete these two once the migration has been run.
LEGACY_SUPABASE_URL=https://xnausliedmpumzkfyrrx.supabase.co
LEGACY_SUPABASE_SERVICE_ROLE_KEY=

# Content generation.
ANTHROPIC_API_KEY=

# Email.
RESEND_API_KEY=
EMAIL_FROM="Pub Quiz Brain <quiz@example.com>"

# Signing secret for the Resend bounce/complaint webhook (starts whsec_).
# Without it /api/webhooks/resend refuses every request.
RESEND_WEBHOOK_SECRET=

# Shared secret the cron routes require as a bearer token, so they are not
# publicly triggerable. Vercel sends this automatically for vercel.json crons.
CRON_SECRET=

# Vercel Blob, for quiz images. Set automatically once a Blob store is linked.
BLOB_READ_WRITE_TOKEN=

# Absolute URL of the deployment, used for magic-link redirects and email links.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
